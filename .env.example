# analytics-mcp — kopieer naar .env en vul in (chmod 600)

PORT=8080
# Moet exact gelijk zijn aan de publieke URL (scheme+host): Google vergelijkt de
# redirect-URI teken voor teken.
BASE_URL=https://analytics.studiovanderheide.nl

# Zelfde OAuth-client als gtm-mcp-server / google-ads-mcp mag gebruikt worden;
# voeg daar dan de redirect-URI https://analytics.studiovanderheide.nl/oauth/callback toe.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sessies overleven hiermee een herstart (mount = analytics-mcp-tokens).
TOKEN_STORE_PATH=/data/tokens.json
ACCESS_TOKEN_TTL=8h
AUTH_AUTO_REFRESH_MAX_AGE=168h

# Aanbevolen: stateless works goed achter nginx (Streamable HTTP, MCP 2026-07-28).
MCP_TRANSPORT=http
MCP_STATELESS_HTTP=true
DASHBOARD_ENABLED=true
TRUST_PROXY=true
LOG_LEVEL=info

# Optioneel: manager-account voor login-customer-id, en een developer token
# (alleen nodig als je er nog een hebt; OAuth-toegang hangt aan het Cloud-project).
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_DEVELOPER_TOKEN=

# Optioneel: extra hostnamen waarvoor de dynamische base-URL-resolver geldt.
# ALLOWED_HOSTS=
